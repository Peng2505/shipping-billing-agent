# Copy this file to .env and fill in locally.
# Never commit .env. Never paste API keys into chat.

# =============================================================================
# LLM — required for Phase 2+ extraction Agent (OpenAI-compatible)
# =============================================================================
# Any OpenAI-compatible endpoint works (OpenAI, DeepSeek, Tongyi, Moonshot, ...).
# The Agent uses LangChain create_agent with Tool Calling + Structured Output.
# On startup the app probes both capabilities with a tiny real request.
#
# Required:
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
#
# Optional (defaults shown):
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=120
# DeepSeek flash/V4 enable thinking by default; thinking rejects tool_choice=required
# which LangChain agents need for tools + structured output. Keep disabled for this project.
LLM_THINKING=disabled
#
# Examples:
#   OpenAI:     LLM_BASE_URL=https://api.openai.com/v1
#               LLM_MODEL=gpt-4o-mini
#   DeepSeek:   LLM_BASE_URL=https://api.deepseek.com
#               LLM_MODEL=deepseek-flash   (or deepseek-chat)
#               LLM_THINKING=disabled
#   Azure-style OpenAI-compatible gateways: set LLM_BASE_URL to the gateway root
#               that serves /chat/completions.

# =============================================================================
# OCR API — assignment endpoint (PDF / images)
# =============================================================================
OCR_ENDPOINT=https://gateway.pltplt.com/ai/process
OCR_TASK=orderChange
OCR_TASK_TYPE=
OCR_CALLBACK=
OCR_CONNECT_TIMEOUT_SECONDS=10
OCR_READ_TIMEOUT_SECONDS=300

# =============================================================================
# Aliyun OSS — private bucket + short-lived signed URL for OCR file=
# Prefer RAM/STS least-privilege credentials. Bucket must NOT be public-read.
# =============================================================================
# Endpoint example: https://oss-cn-shanghai.aliyuncs.com
# Region example:   cn-shanghai
OSS_ENDPOINT=
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Required when using STS temporary credentials:
OSS_SESSION_TOKEN=
OSS_PREFIX=ocr-tmp/
OSS_URL_EXPIRE_SECONDS=1800

# =============================================================================
# File URL provider for OCR file=
#   local_tunnel         — exam/demo path verified with OCR API (Quick Tunnel; not production)
#   aliyun_oss           — private signed URL (OCR historically HTTP 504)
#   cloudflare_r2_worker — R2 + HMAC Worker (OCR historically HTTP 504)
#   empty                — auto-pick configured provider
# After scripts/demo/Start-ExamDemo.ps1, keep:
# =============================================================================
FILE_URL_PROVIDER=local_tunnel
#
# Cloudflare R2 + Worker (private bucket; HMAC download URLs; no public bucket)
R2_WORKER_BASE_URL=
R2_WORKER_UPLOAD_TOKEN=
R2_WORKER_HMAC_SECRET=
R2_WORKER_KEY_PREFIX=ocr-tmp/
R2_WORKER_URL_EXPIRE_SECONDS=1800
R2_WORKER_MAX_UPLOAD_BYTES=20971520
#
# Local Cloudflare Quick Tunnel (exam/demo OCR path — see docs/local_tunnel_provider.md)
# Start: python scripts/local_tunnel/start_gateway.py
LOCAL_TUNNEL_ADMIN_BASE_URL=http://127.0.0.1:8765
LOCAL_TUNNEL_PUBLIC_BASE_URL=
LOCAL_TUNNEL_ADMIN_TOKEN=
LOCAL_TUNNEL_URL_EXPIRE_SECONDS=1800
LOCAL_TUNNEL_MAX_UPLOAD_BYTES=20971520

# =============================================================================
# Upload / parsing limits
# =============================================================================
MAX_FILE_MB=20
MAX_TOTAL_MB=100
MAX_EMAIL_DEPTH=3
MAX_EMAIL_ATTACHMENTS=30

# =============================================================================
# Legacy .doc support (optional LibreOffice)
# =============================================================================
SOFFICE_PATH=
